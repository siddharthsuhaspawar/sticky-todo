{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marc's Three Lists",
  "version": "1.0.0",
  "identifier": "com.threelists.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Marc's Three Lists",
        "width": 820,
        "height": 760,
        "minWidth": 300,
        "minHeight": 320,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
